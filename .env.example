# Copy to .env.local and fill in your values.

# --- Supabase (opcional; copia de respaldo si también usas HubSpot) ---
# Si solo usas HubSpot, deja estas vacías y configura HUBSPOT_* abajo / en Vercel.
# Project URL from Supabase → Settings → API
VITE_SUPABASE_URL=
# anon public key (Settings → API). RLS must allow INSERT for role `anon` on `kunan_leads`.
VITE_SUPABASE_ANON_KEY=

# --- Google Tag Manager (recomendado si Google pide "instalar GTM") ---
# tagmanager.google.com → Admin → ID del contenedor (GTM-XXXXXXX)
# Si usas GTM, añade el tag GA4 dentro de GTM y puedes dejar VITE_GA4 vacío en producción.
VITE_GTM_CONTAINER_ID=

# --- Google Analytics 4 (optional; see README + src/lib/analytics.ts) ---
# GA4 Admin → Data streams → Measurement ID (G-XXXXXXXXXX). Usar si NO tienes contenedor GTM.
VITE_GA4_MEASUREMENT_ID=G-TC8BYE6BYQ

# --- Meta Pixel (optional; see README + src/lib/analytics.ts) ---
# Meta Events Manager → Pixel ID (numeric string)
VITE_META_PIXEL_ID=

# --- SEO / sharing (optional; see README + src/components/Seo.tsx) ---
# Full URL of this page for <link rel="canonical"> and schema url
VITE_SITE_CANONICAL_URL=https://example.com
# Site origin without trailing slash — JSON-LD @id, og:url fallback
VITE_PUBLIC_SITE_URL=https://example.com
# Absolute image URL for LinkedIn/OG (optional; else {PUBLIC}/favicon.svg)
# VITE_OG_IMAGE_URL=

# --- n8n (opcional; correos / automatización) ---
# Solo si el webhook existe y responde 2xx. NO dejar URLs muertas.
# VITE_N8N_WEBHOOK_URL=

# --- HubSpot (leads del formulario → CRM) ---
# Formulario "Solicitar demo" (IDs del embed hsforms). Ya hay fallback en código.
HUBSPOT_PORTAL_ID=51619844
HUBSPOT_FORM_GUID=58df5fa0-2b32-4e55-8834-71b84d7171a4
# Opcional en cliente (mismo valor; el código ya usa fallback):
# VITE_HUBSPOT_PORTAL_ID=51619844
# VITE_HUBSPOT_FORM_GUID=58df5fa0-2b32-4e55-8834-71b84d7171a4
